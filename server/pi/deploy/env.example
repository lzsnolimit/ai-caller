# Copy to ~/.config/phone-call-gateway/env and run: chmod 600 ~/.config/phone-call-gateway/env
# Use your own OpenAI API key. Never commit the real file.
OPENAI_API_KEY=<your-key>
# Optional: an OpenAI-compatible endpoint. Set both lines together.
# OPENAI_LIVE_URL=wss://<host>/v1/live/sessions
# OPENAI_LIVE_AUTH_HEADER=api-key
